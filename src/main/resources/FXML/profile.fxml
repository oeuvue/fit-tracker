<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controller.ProfileController">
    <children>
        <Label layoutX="40.0" layoutY="30.0" text="My Profile &amp; Goals">
            <font><Font name="System Bold" size="24.0" /></font>
        </Label>

        <VBox layoutX="40.0" layoutY="90.0" spacing="15.0">
            <children>
                <HBox spacing="10.0"><Label text="Username:" prefWidth="100.0" /><Label fx:id="usernameLabel" text="---" style="-fx-font-weight: bold;" /></HBox>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Age:" prefWidth="100.0" />
                    <TextField fx:id="ageField" prefWidth="80.0" />
                </HBox>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Weight (kg):" prefWidth="100.0" />
                    <TextField fx:id="weightField" prefWidth="80.0" />
                </HBox>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Height (cm):" prefWidth="100.0" />
                    <TextField fx:id="heightField" prefWidth="80.0" />
                </HBox>

                <Separator />

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Activity Level:" prefWidth="100.0" />
                    <ChoiceBox fx:id="activityChoiceBox" prefWidth="150.0" />
                </HBox>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Fitness Goal:" prefWidth="100.0" />
                    <ChoiceBox fx:id="goalChoiceBox" prefWidth="150.0" />
                </HBox>

                <Button onAction="#handleSaveProfile" text="Save Profile" style="-fx-background-color: #3498db; -fx-text-fill: white;" prefWidth="150.0"/>
            </children>
        </VBox>


        <Button layoutX="40.0" layoutY="440.0" onAction="#handleBack" text="Back to Menu" />
    </children>
</AnchorPane>